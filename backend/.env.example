# Copie este arquivo para ".env" e preencha o que quiser (tudo é opcional).

# Força o modo offline (usa só data/fallback_b3.json). Útil para demonstrações.
ALPHARADAR_OFFLINE=0

# Token da brapi.dev (fonte secundária de cotações): https://brapi.dev
BRAPI_TOKEN=

# Feeds RSS de notícias, separados por vírgula. Vazio = notícias de demonstração.
NEWS_RSS_URLS=

# ---- IA do Analista (use uma ou mais; o app tenta na ordem e passa para a próxima se uma falhar) ----
# GRATUITAS
# Google Gemini (https://aistudio.google.com/apikey) - plano gratuito, sem cartão. Modelo padrão: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq (https://console.groq.com/keys) - plano gratuito, muito rápido. Modelo padrão: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
# OpenRouter (https://openrouter.ai/keys) - modelos ":free". Modelo padrão: google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# PAGAS (opcionais)
# DeepSeek (https://platform.deepseek.com) - exige saldo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Forçar um provedor: auto | gemini | groq | openrouter | deepseek | anthropic
AI_PROVIDER=auto

# Chave da API da Anthropic para o analista de IA generativa (Claude).
# Sem nenhuma chave, o copiloto usa o motor de regras em Python (gratuito).
ANTHROPIC_API_KEY=
# Modelo opcional (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=

# ---- APIs de notícias (todas opcionais; cada uma só funciona com a sua chave) ----
# Currents API (https://currentsapi.services) - 250 req/dia, tempo real, Brasil em português. A mais útil.
CURRENTS_API_KEY=
# GNews (https://gnews.io) - 100 req/dia, filtro por país; plano gratuito tem ~12 h de atraso.
GNEWS_API_KEY=
# The Guardian (https://open-platform.theguardian.com) - negócios globais, em inglês.
GUARDIAN_API_KEY=
# New York Times (https://developer.nytimes.com) - Top Stories de negócios, em inglês.
NYT_API_KEY=
# NewsAPI.org - plano gratuito: atraso de 24 h e proibido em produção. Pouco útil.
NEWSAPI_KEY=
